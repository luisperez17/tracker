   "source": [
    "# 🎯 MTM Tracker V4 — Análisis Semanal (Colab)\n",
    "\n",
    "**Uso:** Ejecutar cada viernes después del cierre de mercado.\n",
    "\n",
    "**Conecta con:** Tu Google Sheet (Score Log V4 + Radar Semanal)\n",
    "\n",
    "**Genera:** Curva de equity, métricas de rendimiento, heatmaps de sector, insights de aprendizaje."
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Instalación y conexión a Google Sheets"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Instalar librerías (solo la primera vez por sesión)\n",
    "!pip install gspread pandas matplotlib seaborn --quiet\n",
    "\n",
    "import gspread\n",
    "from google.colab import auth\n",
    "from google.auth import default\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "from datetime import datetime\n",
    "import numpy as np\n",
    "\n",
    "# Autenticar con tu cuenta Google\n",
    "auth.authenticate_user()\n",
    "creds, _ = default()\n",
    "gc = gspread.authorize(creds)\n",
    "\n",
    "# Abrir tu spreadsheet (cambiar por el ID real)\n",
    "SPREADSHEET_ID = 'TU_SPREADSHEET_ID_AQUI'\n",
    "sh = gc.open_by_key(SPREADSHEET_ID)\n",
    "\n",
    "print(\"✅ Conectado a:\", sh.title)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Leer datos del Score Log V4"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Leer Score Log V4\n",
    "ws_log = sh.worksheet('📊 Score Log V4')\n",
    "data_log = ws_log.get_all_values()\n",
    "\n",
    "df_log = pd.DataFrame(data_log[2:], columns=data_log[1])  # saltar título\n",
    "df_log.columns = ['fecha', 'ticker', 'precio', 'score_v4', 'perf_w', 'perf_m', 'sma20', 'tracker']\n",
    "\n",
    "# Limpiar\n",
    "df_log['fecha'] = pd.to_datetime(df_log['fecha'], dayfirst=True, errors='coerce')\n",
    "df_log['precio'] = pd.to_numeric(df_log['precio'].astype(str).str.replace(',','.'), errors='coerce')\n",
    "df_log['score_v4'] = pd.to_numeric(df_log['score_v4'], errors='coerce')\n",
    "\n",
    "print(f\"📊 Score Log: {len(df_log)} registros\")\n",
    "df_log.head()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Métricas de rendimiento por semana"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Agrupar por ticker para calcular P&L semanal\n",
    "df_log = df_log.sort_values(['ticker', 'fecha'])\n",
    "\n",
    "# Calcular P&L por ticker (primero vs último de la semana)\n",
    "def calcular_pnl(group):\n",
    "    if len(group) < 2:\n",
    "        return pd.Series({'pnl_pct': 0, 'precio_ini': group['precio'].iloc[0]})\n",
    "    ini = group['precio'].iloc[0]\n",
    "    fin = group['precio'].iloc[-1]\n",
    "    pnl = ((fin - ini) / ini) * 100 if ini and ini > 0 else 0\n",
    "    return pd.Series({'pnl_pct': pnl, 'precio_ini': ini, 'precio_fin': fin})\n",
    "\n",
    "# Agrupar por semana (lunes a viernes)\n",
    "df_log['semana'] = df_log['fecha'].dt.to_period('W')\n",
    "resultados = df_log.groupby(['semana', 'ticker']).apply(calcular_pnl).reset_index()\n",
    "\n",
    "# Métricas globales\n",
    "winners = len(resultados[resultados['pnl_pct'] > 0])\n",
    "losers = len(resultados[resultados['pnl_pct'] <= 0])\n",
    "total = len(resultados)\n",
    "win_rate = (winners / total * 100) if total > 0 else 0\n",
    "avg_pnl = resultados['pnl_pct'].mean()\n",
    "max_gain = resultados['pnl_pct'].max()\n",
    "max_loss = resultados['pnl_pct'].min()\n",
    "\n",
    "print(f\"📈 Total setups analizados: {total}\")\n",
    "print(f\"✅ Ganadores: {winners} ({win_rate:.1f}%)\")\n",
    "print(f\"❌ Perdedores: {losers} ({100-win_rate:.1f}%)\")\n",
    "print(f\"📊 P&L promedio: {avg_pnl:.2f}%\")\n",
    "print(f\"🚀 Mejor trade: {max_gain:.2f}%\")\n",
    "print(f\"💀 Peor trade: {max_loss:.2f}%\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. ¿El Score V4 predice? (Análisis de correlación)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Mergear score con resultado\n",
    "df_merge = df_log.merge(resultados, on=['semana', 'ticker'])\n",
    "\n",
    "# Tomar el primer registro de cada semana-ticker (score inicial)\n",
    "df_first = df_merge.groupby(['semana', 'ticker']).first().reset_index()\n",
    "\n",
    "# Correlación Score V4 vs P&L\n",
    "corr = df_first[['score_v4', 'pnl_pct']].corr().iloc[0,1]\n",
    "print(f\"🔗 Correlación Score V4 → P&L: {corr:.3f}\")\n",
    "print(\"Interpretación:\")\n",
    "print(\"  > 0.3 = Sí predice (bueno)\")\n",
    "print(\"  0.1 a 0.3 = Débil\")\n",
    "print(\"  < 0.1 = No predice (revisar fórmula)\")\n",
    "\n",
    "# Scatter plot\n",
    "plt.figure(figsize=(10,6))\n",
    "sns.scatterplot(data=df_first, x='score_v4', y='pnl_pct', alpha=0.6)\n",
    "plt.axhline(0, color='red', linestyle='--', alpha=0.3)\n",
    "plt.axvline(4, color='green', linestyle='--', alpha=0.3, label='Umbral Media Conf')\n",
    "plt.title('Score V4 vs Resultado Real (%)')\n",
    "plt.xlabel('Score V4 (inicio de semana)')\n",
    "plt.ylabel('P&L Semanal (%)')\n",
    "plt.legend()\n",
    "plt.grid(alpha=0.2)\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. Curva de Equity acumulada"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Calcular equity curve (asumiendo $1000 inicial, riesgo fijo por trade)\n",
    "CAPITAL_INICIAL = 2000\n",
    "RIESGO_PCT = 0.03  # 3% por trade\n",
    "\n",
    "equity = [CAPITAL_INICIAL]\n",
    "for _, row in resultados.iterrows():\n",
    "    pnl = row['pnl_pct'] / 100\n",
    "    # Asumimos que el riesgo es lo que perdemos si va mal, y ganancia proporcional\n",
    "    retorno = pnl * RIESGO_PCT  # simplificación\n",
    "    equity.append(equity[-1] * (1 + retorno))\n",
    "\n",
    "resultados['equity'] = equity[1:]\n",
    "\n",
    "plt.figure(figsize=(12,6))\n",
    "plt.plot(resultados.index, resultados['equity'], color='#00C853', linewidth=2)\n",
    "plt.fill_between(resultados.index, resultados['equity'], CAPITAL_INICIAL, alpha=0.2, color='#00C853')\n",
    "plt.axhline(CAPITAL_INICIAL, color='gray', linestyle='--', alpha=0.5)\n",
    "plt.title('📈 Curva de Equity MTM V4')\n",
    "plt.xlabel('Trade #')\n",
    "plt.ylabel('Capital ($)')\n",
    "plt.grid(alpha=0.2)\n",
    "plt.show()\n",
    "\n",
    "print(f\"Capital inicial: ${CAPITAL_INICIAL:,.2f}\")\n",
    "print(f\"Capital final simulado: ${equity[-1]:,.2f}\")\n",
    "print(f\"Retorno total: {((equity[-1]/CAPITAL_INICIAL)-1)*100:.2f}%\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6. Tabla de aprendizaje (exportar a Sheets)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Generar insights\n",
    "insights = []\n",
    "\n",
    "# Insight 1: Score vs Win Rate\n",
    "df_first['score_bucket'] = pd.cut(df_first['score_v4'], bins=[0,2,4,6,10], labels=['<2','2-4','4-6','>6'])\n",
    "score_stats = df_first.groupby('score_bucket').agg(\n",
    "    win_rate=('pnl_pct', lambda x: (x > 0).mean() * 100),\n",
    "    avg_pnl=('pnl_pct', 'mean'),\n",
    "    count=('pnl_pct', 'count')\n",
    ").reset_index()\n",
    "\n",
    "print(\"📊 Win Rate por rango de Score V4:\")\n",
    "print(score_stats)\n",
    "\n",
    "# Insight 2: Mejor día de entrada\n",
    "df_log['dia_semana'] = df_log['fecha'].dt.day_name()\n",
    "# (requiere más lógica para calcular día óptimo, simplificado)\n",
    "\n",
    "# Preparar tabla para exportar a Google Sheets\n",
    "tabla_export = [\n",
    "    ['Aprendizaje', 'Resultado', 'Significado'],\n",
    "    ['Win Rate Score >6', f\"{score_stats.iloc[-1]['win_rate']:.1f}%\", 'El score alto SÍ filtra setups mejores'],\n",
    "    ['Win Rate Score 2-4', f\"{score_stats.iloc[1]['win_rate']:.1f}%\", 'Riesgo moderado, setups mediocres'],\n",
    "    ['Mejor trade', f\"{max_gain:.2f}%\", '¿Qué tenía de especial? Revisar en Radar.'],\n",
    "    ['Peor trade', f\"{max_loss:.2f}%\", '¿Violó alguna regla del sistema?'],\n",
    "    ['Correlación Score→P&L', f\"{corr:.3f}\", 'A más alta, más confiable es el score.']\n",
    "]\n",
    "\n",
    "# Escribir en hoja " + "🔬 Colab Output" + "\n",
    "try:\n",
    "    ws_out = sh.worksheet('🔬 Colab Output')\n",
    "except:\n",
    "    ws_out = sh.add_worksheet(title='🔬 Colab Output', rows=20, cols=3)\n",
    "\n",
    "ws_out.clear()\n",
    "ws_out.update('A1:C' + str(len(tabla_export)), tabla_export)\n",
    "print(\"✅ Tabla de aprendizaje exportada a '🔬 Colab Output'\")"
   ]
  },
